# Copy to .env and fill in. NEVER commit .env. The key stays on the server and is
# never sent to the browser.

# --- LLM (leave LLM_API_KEY empty to run in clearly-labelled DEMO mode) ---------
# Provider: "gemini" (default) or "openai_compat" (OpenAI, Groq, OpenRouter, ...)
LLM_PROVIDER=gemini
LLM_API_KEY=
# REQUIRED when a key is set. Model IDs change over time, so there is no default:
# copy a current text model ID from Google AI Studio (or your provider's docs).
LLM_MODEL=
# Optional endpoint override (leave empty for the provider default)
LLM_BASE_URL=
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.8
# Extra attempts per reaction when the model returns invalid JSON or a fake quote
REACTION_MAX_RETRIES=2

# --- App ---
DATABASE_PATH=./brutal_audience.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONTENT_CHARS=60000
MAX_SEGMENTS=80
